# Copy to .env and fill in. See README.md for what each variable does.

KASM_API_URL=https://kasm.example.com
KASM_API_KEY=
KASM_API_SECRET=
KASM_USER_ID=

# Optional
# KASM_ALLOWED_ROOTS=/home/kasm-user,/tmp
# KASM_ADMIN_MODE=false
# KASM_UNOFFICIAL_API=false
# KASM_SSH_ENABLED=false
# KASM_SSH_KEY_PATH=
# KASM_SSH_USER=kasm-user
# KASM_SSH_HOST_OVERRIDE=
